  "markup": "<div class=\"canvas-card research-map-slide\">\n  <div class=\"chrome-min\"><div class=\"l\">RESEARCH PROCESS · CO-RESEARCH FRAMEWORK</div><div class=\"r\">05 / 18</div></div>\n  <header class=\"rm-header\">\n    <div><h2 data-i18n=\"slides.s08.map.title\">研究流程</h2></div>\n    <div class=\"rm-meta\"><div class=\"rm-strategy\"><span data-i18n=\"slides.s08.map.strategyLabel\">研究策略</span><strong data-i18n=\"slides.s08.map.strategy\">共创研究</strong></div><div class=\"rm-framework\"><span>FRAMEWORK</span><div class=\"rm-framework-diagram\"><b data-i18n=\"slides.s08.map.frameworkTheory\">理论</b><b data-i18n=\"slides.s08.map.frameworkMethod\">方法</b><b data-i18n=\"slides.s08.map.frameworkPractice\">实践</b></div></div></div>\n  </header>\n  <section class=\"rm-map\">\n    <div class=\"rm-objective rm-objective--one\"><span>OBJ. 01</span><strong data-i18n=\"slides.s08.map.objective1\">建立注意力导向的解说标识原则</strong><small>BUILD PRINCIPLES</small></div>\n    <article class=\"rm-step\"><div class=\"rm-step-no\">01</div><div class=\"rm-method\"><strong data-i18n=\"slides.s08.map.step1.title\">理论与现状诊断</strong><div class=\"rm-method-participants\"><svg class=\"lucide rm-participant-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"></path></svg><div><span data-i18n=\"slides.s08.map.people.experts\">专家</span><span data-i18n=\"slides.s08.map.people.designers\">设计师</span></div></div></div><div class=\"rm-technique\"><p data-i18n=\"slides.s08.map.step1.method\">文献综述、实地调查、标识审计与访谈</p></div><div class=\"rm-output\"><span>FOUNDATION</span><strong data-i18n=\"slides.s08.map.step1.output\">研究缺口与理论框架</strong></div></article>\n    <article class=\"rm-step\"><div class=\"rm-step-no\">02</div><div class=\"rm-method\"><strong data-i18n=\"slides.s08.map.step2.title\">三方共创与轴向编码</strong><div class=\"rm-method-participants\"><svg clas