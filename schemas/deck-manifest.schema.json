{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/deck-manifest.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "deckId",
    "defaultLanguage",
    "languages",
    "compositeLanguages",
    "chapters",
    "layouts",
    "assets",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "deckId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "defaultLanguage": { "type": "string" },
    "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "compositeLanguages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["primary", "secondary", "policy"],
        "additionalProperties": false,
        "properties": {
          "primary": { "type": "string" },
          "secondary": { "type": "string" },
          "policy": { "const": "balanced-emphasis" }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titleKey"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "titleKey": { "type": "string" }
        }
      }
    },
    "layouts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "access"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "legacyPath": { "type": "string" },
          "access": { "enum": ["public", "internal", "restricted-derived", "restricted-raw"] }
        }
      }
    },
    "crossPageComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instanceId", "componentId", "from", "to", "durationMs"],
        "additionalProperties": false,
        "properties": {
          "instanceId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "from": { "$ref": "#/$defs/crossPageEndpoint" },
          "to": { "$ref": "#/$defs/crossPageEndpoint" },
          "durationMs": { "type": "integer", "minimum": 200, "maximum": 1200 }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chapterId", "layout", "content", "assets", "claims"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "chapterId": { "type": "string" },
          "layout": { "type": "string" },
          "content": { "type": "string" },
          "assets": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "claims": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "crossPageEndpoint": {
      "type": "object",
      "required": ["slideId", "variant"],
      "additionalProperties": false,
      "properties": {
        "slideId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "variant": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
      }
    }
  }
}
